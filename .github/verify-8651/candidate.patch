+
+    @Test
+    void importsSeparateOperationsAndReimportsWithoutChangingAnotherMethod() {
+        final String fixture = "same-path-" + UUID.randomUUID();
+        final String path = "/" + fixture + "/orders";
+        final UpstreamInstance instance = instanceFor(fixture);
+        importSpec(instance, document(fixture, """
+                "patch":{"summary":"Existing operation","responses":{"200":{"description":"OK"}}}
+                """), null);
+        final List<Map<String, Object>> existing = rows(path, ApiHttpMethodEnum.PATCH);
+        assertEquals(1, existing.size());
+
+        final String initialDigest = importSpec(instance, document(fixture, """
+                "get":{"summary":"List orders","responses":{"200":{"description":"OK"}}},
+                "post":{"summary":"Place order","responses":{"201":{"description":"Created"}}}
+                """), null);
+        final List<String> initial = List.of(summary(path, ApiHttpMethodEnum.GET), summary(path, ApiHttpMethodEnum.POST));
+
+        final String afterDigest = importSpec(instance, document(fixture, """
+                "get":{"summary":"List orders again","responses":{"200":{"description":"OK"}}},
+                "post":{"summary":"Place order again","responses":{"201":{"description":"Created"}}}
+                """), initialDigest);
+        final List<String> after = List.of(summary(path, ApiHttpMethodEnum.GET), summary(path, ApiHttpMethodEnum.POST));
+        assertAll(
+                () -> assertNotEquals(initialDigest, afterDigest),
+                () -> assertEquals(List.of("List orders", "Place order"), initial),
+                () -> assertEquals(List.of("List orders again", "Place order again"), after),
+                () -> assertEquals(3, count(path)),
+                () -> assertEquals(1, rows(path, ApiHttpMethodEnum.GET).size()),
+                () -> assertEquals(1, rows(path, ApiHttpMethodEnum.POST).size()),
+                () -> assertEquals(existing, rows(path, ApiHttpMethodEnum.PATCH)));
+    }
+
+    @Test
+    void importsPutAndDeleteWithoutInventingGet() {
+        final String fixture = "same-path-" + UUID.randomUUID();
+        final String path = "/" + fixture + "/orders";
+        final UpstreamInstance instance = instanceFor(fixture);
+        importSpec(instance, document(fixture, """
+                "delete":{"summary":"Delete order","responses":{"204":{"description":"Removed"}}},
+                "put":{"summary":"Replace order","responses":{"200":{"description":"OK"}}}
+                """), null);
+        assertAll(
+                () -> assertEquals(2, count(path)),
+                () -> assertEquals("Delete order", summary(path, ApiHttpMethodEnum.DELETE)),
+                () -> assertEquals("Replace order", summary(path, ApiHttpMethodEnum.PUT)),
+                () -> assertEquals(0, rows(path, ApiHttpMethodEnum.GET).size()));
+    }
+
+    @Test
+    void leavesTheExistingRuleConditionWhenImportingAnotherMethodForThePath() {
+        final String fixture = "same-path-" + UUID.randomUUID();
+        final String path = "/" + fixture + "/orders";
+        final UpstreamInstance instance = instanceFor(fixture);
+        importSpec(instance, document(fixture, """
+                "post":{"summary":"Existing POST","responses":{"200":{"description":"OK"}}}
+                """), null);
+        final Object existingPostId = rows(path, ApiHttpMethodEnum.POST).get(0).get("id");
+        final String rule = seedRule(fixture, path);
+        importSpec(instance, document(fixture, """
+                "get":{"summary":"New GET","responses":{"200":{"description":"OK"}}},
+                "post":{"summary":"Updated POST","responses":{"200":{"description":"OK"}}}
+                """), null);
+        assertAll(
+                () -> assertEquals(List.of("existing"), jdbc.queryForList(
+                        "SELECT param_value FROM rule_condition WHERE rule_id = ?", String.class, rule)),
+                () -> assertEquals(existingPostId, rows(path, ApiHttpMethodEnum.POST).get(0).get("id")),
+                () -> assertEquals("Updated POST", summary(path, ApiHttpMethodEnum.POST)),
+                () -> assertEquals("New GET", summary(path, ApiHttpMethodEnum.GET)));
+    }
+
+    @Test
+    void preservesTheLegacySwagger2UploadRegistrationOnReimport() {
+        final String fixture = "same-path-" + UUID.randomUUID();
+        final String path = "/" + fixture + "/uploads";
+        final UpstreamInstance instance = instanceFor(fixture);
+        final String upload = """
+                "put":{"summary":"Replace file","consumes":["multipart/form-data"],
+                       "parameters":[{"name":"file","in":"formData","type":"file"}],"responses":{"200":{"description":"OK"}}}
+                """;
+        final String spec = """
+                {"swagger":"2.0","info":{"title":"File","version":"1.0"},"basePath":"/%s","paths":{"/uploads":{%s}}}
+                """;
+        importSpec(instance, spec.formatted(fixture, upload), null);
+        final List<Map<String, Object>> initial = rows(path, ApiHttpMethodEnum.POST);
+        assertEquals(1, initial.size());
+        importSpec(instance, spec.formatted(fixture, upload.replace("Replace file", "Replace file again")), null);
+        assertAll(
+                () -> assertEquals(initial.get(0).get("id"), rows(path, ApiHttpMethodEnum.POST).get(0).get("id")),
+                () -> assertEquals("Replace file again", summary(path, ApiHttpMethodEnum.POST)),
+                () -> assertEquals(0, rows(path, ApiHttpMethodEnum.PUT).size()));
+    }
+
+    @Test
+    void importsAnOperationWithALocalParameterReferenceAlongsideAnotherMethod() {
+        final String fixture = "same-path-" + UUID.randomUUID();
+        final String path = "/" + fixture + "/orders";
+        final UpstreamInstance instance = instanceFor(fixture);
+        importSpec(instance, """
+                {"openapi":"3.0.3","info":{"title":"Orders","version":"1.0"},
+                 "servers":[{"url":"/%s"}],
+                 "components":{"parameters":{"Tenant":{"name":"X-Tenant","in":"header","required":true,"schema":{"type":"string"}}}},
+                 "paths":{"/orders":{
+                   "get":{"summary":"List orders","responses":{"200":{"description":"OK"}}},
+                   "post":{"summary":"Place order","parameters":[{"$ref":"#/components/parameters/Tenant"}],
+                           "responses":{"201":{"description":"Created"}}}}}}
+                """.formatted(fixture), null);
+        assertEquals("List orders", summary(path, ApiHttpMethodEnum.GET));
+        assertEquals("Place order", summary(path, ApiHttpMethodEnum.POST));
+        final JsonObject header = JsonParser.parseString((String) rows(path, ApiHttpMethodEnum.POST).get(0).get("document"))
+                .getAsJsonObject().getAsJsonArray("requestHeaders").get(0).getAsJsonObject();
+        assertAll(
+                () -> assertEquals("X-Tenant", header.get("name").getAsString()),
+                () -> assertEquals("string", header.get("type").getAsString()),
+                () -> assertTrue(header.get("required").getAsBoolean()));
+    }
+
+    @Test
+    void deletingOneImportedMethodLeavesTheSharedRuleForTheOtherMethod() {
+        final String fixture = "same-path-" + UUID.randomUUID();
+        final String path = "/" + fixture + "/orders";
+        final UpstreamInstance instance = instanceFor(fixture);
+        importSpec(instance, document(fixture, """
+                "get":{"summary":"List orders","responses":{"200":{"description":"OK"}}},
+                "post":{"summary":"Place order","responses":{"201":{"description":"Created"}}}
+                """), null);
+        final String rule = seedRule(fixture, path);
+        final Subject previous = ThreadContext.getSubject();
+        final Subject administrator = mock(Subject.class);
+        when(administrator.isPermitted("system:plugin:delete")).thenReturn(true);
+        ThreadContext.bind(administrator);
+        try {
+            apiService.delete(List.of((String) rows(path, ApiHttpMethodEnum.GET).get(0).get("id")));
+            assertAll(
+                    () -> assertEquals(0, rows(path, ApiHttpMethodEnum.GET).size()),
+                    () -> assertEquals("Place order", summary(path, ApiHttpMethodEnum.POST)),
+                    () -> assertEquals(List.of("existing"), jdbc.queryForList(
+                            "SELECT param_value FROM rule_condition WHERE rule_id = ?", String.class, rule)));
+            apiService.delete(List.of((String) rows(path, ApiHttpMethodEnum.POST).get(0).get("id")));
+            assertEquals(0, jdbc.queryForObject("SELECT count(*) FROM rule WHERE id = ?", Integer.class, rule));
+        } finally {
+            ThreadContext.unbindSubject();
+            if (Objects.nonNull(previous)) {
+                ThreadContext.bind(previous);
+            }
+        }
+    }
+
+    @Test
+    void deletingMethodsConcurrentlyCleansTheSharedRule() throws Exception {
+        final String fixture = "same-path-" + UUID.randomUUID();
+        final String path = "/" + fixture + "/orders";
+        final UpstreamInstance instance = instanceFor(fixture);
+        importSpec(instance, document(fixture, """
+                "get":{"summary":"List orders","responses":{"200":{"description":"OK"}}},
+                "post":{"summary":"Place order","responses":{"201":{"description":"Created"}}}
+                """), null);
+        final String rule = seedRule(fixture, path);
+        final String getId = (String) rows(path, ApiHttpMethodEnum.GET).get(0).get("id");
+        final String postId = (String) rows(path, ApiHttpMethodEnum.POST).get(0).get("id");
+        final CountDownLatch ready = new CountDownLatch(2);
+        final CountDownLatch start = new CountDownLatch(1);
+        final ExecutorService workers = Executors.newFixedThreadPool(2);
+        try {
+            final Future<?> first = workers.submit(() -> deleteAsAdministrator(getId, ready, start));
+            final Future<?> second = workers.submit(() -> deleteAsAdministrator(postId, ready, start));
+            assertTrue(ready.await(5, TimeUnit.SECONDS));
+            start.countDown();
+            first.get(10, TimeUnit.SECONDS);
+            second.get(10, TimeUnit.SECONDS);
+            assertEquals(0, count(path));
+            assertEquals(0, jdbc.queryForObject("SELECT count(*) FROM rule WHERE id = ?", Integer.class, rule));
+        } finally {
+            workers.shutdownNow();
+        }
+    }
+
+    private void deleteAsAdministrator(final String id, final CountDownLatch ready, final CountDownLatch start) {
+        final Subject administrator = mock(Subject.class);
+        when(administrator.isPermitted("system:plugin:delete")).thenReturn(true);
+        ThreadContext.bind(administrator);
+        try {
+            ready.countDown();
+            assertTrue(start.await(5, TimeUnit.SECONDS));
+            apiService.delete(List.of(id));
+        } catch (InterruptedException ex) {
+            Thread.currentThread().interrupt();
+            throw new AssertionError(ex);
+        } finally {
+            ThreadContext.unbindSubject();
+        }
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {true, false})
+    void distinguishesTheLegacyPlaceholderFromARealGet(final boolean legacy) {
+        final String fixture = "same-path-" + UUID.randomUUID();
+        final String path = "/" + fixture + "/orders";
+        final UpstreamInstance instance = instanceFor(fixture);
+        importSpec(instance, document(fixture, """
+                "get":{"summary":"Existing document","responses":{"200":{"description":"OK"}}}
+                """), null);
+        final Map<String, Object> original = rows(path, ApiHttpMethodEnum.GET).get(0);
+        final String rule = seedRule(fixture, path);
+        if (legacy) {
+            final JsonObject legacyDoc = JsonParser.parseString((String) original.get("document")).getAsJsonObject();
+            legacyDoc.add("httpMethodList", JsonParser.parseString("[\"delete\",\"put\"]"));
+            jdbc.update("UPDATE api SET document = ? WHERE id = ?", legacyDoc.toString(), original.get("id"));
+        }
+        importSpec(instance, document(fixture, """
+                "delete":{"summary":"Delete order","responses":{"204":{"description":"Removed"}}},
+                "put":{"summary":"Replace order","responses":{"200":{"description":"OK"}}}
+                """), null);
+        assertAll(
+                () -> assertEquals(legacy ? List.of() : List.of(original), rows(path, ApiHttpMethodEnum.GET)),
+                () -> assertEquals("Delete order", summary(path, ApiHttpMethodEnum.DELETE)),
+                () -> assertEquals("Replace order", summary(path, ApiHttpMethodEnum.PUT)),
+                () -> assertEquals(List.of("existing"), jdbc.queryForList(
+                        "SELECT param_value FROM rule_condition WHERE rule_id = ?", String.class, rule)));
+    }
+
+    private UpstreamInstance instanceFor(final String fixture) {
+        final UpstreamInstance instance = new UpstreamInstance();
+        instance.setContextPath("/" + fixture);
+        instance.setIp("127.0.0.1");
+        instance.setPort(8190);
+        return instance;
+    }
+
+    private String seedRule(final String fixture, final String path) {
+        final String pluginId = jdbc.queryForObject("SELECT id FROM plugin WHERE name = 'divide'", String.class);
+        final String selector = fixture + "-selector";
+        final String rule = fixture + "-rule";
+        jdbc.update("INSERT INTO selector (id, plugin_id, selector_name, match_mode, selector_type, sort_code, "
+                        + "handle, enabled, logged, continued, match_restful, namespace_id) "
+                        + "VALUES (?, ?, ?, 0, 1, 1, '{}', true, false, false, false, ?)",
+                selector, pluginId, "/" + fixture, SYS_DEFAULT_NAMESPACE_ID);
+        jdbc.update("INSERT INTO rule (id, selector_id, rule_name, match_mode, sort_code, handle, enabled, logged, match_restful, namespace_id) "
+                        + "VALUES (?, ?, ?, 0, 1, '{}', true, false, false, ?)", rule, selector, path, SYS_DEFAULT_NAMESPACE_ID);
+        jdbc.update("INSERT INTO rule_condition (id, rule_id, param_type, operator, param_name, param_value) "
+                        + "VALUES (?, ?, 'header', '=', 'X-Shop', 'existing')", fixture + "-condition", rule);
+        return rule;
+    }
+
+    private String importSpec(final UpstreamInstance instance, final String body, final String previousDigest) {
+        AtomicReference<String> digest = new AtomicReference<>();
+        importer.addDocInfo(instance, body, previousDigest, (DocInfo info) -> digest.set(info.getDocMd5()));
+        assertNotNull(digest.get());
+        return digest.get();
+    }
+
+    private String document(final String fixture, final String operations) {
+        return """
+                {"openapi":"3.0.3","info":{"title":"Orders","version":"1.0"},
+                 "servers":[{"url":"/%s"}],"paths":{"/orders":{%s}}}
+                """.formatted(fixture, operations);
+    }
+
+    private List<Map<String, Object>> rows(final String path, final ApiHttpMethodEnum method) {
+        return jdbc.queryForList("select id, document from api where api_path = ? and http_method = ?", path, method.getValue());
+    }
+
+    private int count(final String path) {
+        return jdbc.queryForObject("select count(*) from api where api_path = ?", Integer.class, path);
+    }
+
+    private String summary(final String path, final ApiHttpMethodEnum method) {
+        List<String> documents = jdbc.queryForList("select document from api where api_path = ? and http_method = ?", String.class, path, method.getValue());
+        return documents.size() == 1 ? JsonParser.parseString(documents.get(0)).getAsJsonObject().get("summary").getAsString() : "missing-or-duplicate";
+    }
+}
