+class SwaggerSamePathOperationsRegistrationTest {
+
+    @Test
+    void keepsDistinctOperationsAndLeavesOtherMethodsUntouchedAcrossRepeatedImports() {
+        final String body = """
+                {"openapi":"3.0.3","info":{"title":"Orders","version":"1.0"},
+                 "servers":[{"url":"/shop"}],
+                 "paths":{"/orders":{
+                    "get":{"summary":"List orders","responses":{"200":{"description":"OK"}}},
+                    "post":{"summary":"Place order","responses":{"201":{"description":"Created"}}}
+                 }}}
+                """;
+        ApiService apiService = mock(ApiService.class);
+        TagService tagService = mock(TagService.class);
+        TagVO tag = mock(TagVO.class);
+        when(tag.getId()).thenReturn("tag-orders");
+        when(tagService.findByQuery(anyString())).thenReturn(List.of(tag));
+        RegisterApiDocServiceImpl register = new RegisterApiDocServiceImpl();
+        ReflectionTestUtils.setField(register, "apiService", apiService);
+        ReflectionTestUtils.setField(register, "tagService", tagService);
+        DocManagerImpl importer = new DocManagerImpl();
+        ReflectionTestUtils.setField(importer, "registerApiDocService", register);
+        UpstreamInstance instance = new UpstreamInstance();
+        instance.setContextPath("/shop");
+        instance.setIp("127.0.0.1");
+        instance.setPort(8190);
+
+        final Integer get = ApiHttpMethodEnum.GET.getValue();
+        final Integer post = ApiHttpMethodEnum.POST.getValue();
+        Integer put = ApiHttpMethodEnum.PUT.getValue();
+        Map<Integer, String> registeredSummaries = new LinkedHashMap<>();
+        registeredSummaries.put(put, "Manually managed operation");
+        doAnswer(invocation -> {
+            assertEquals("/shop/orders", invocation.getArgument(0));
+            assertEquals(RpcTypeEnum.HTTP.getName(), invocation.getArgument(2));
+            registeredSummaries.remove(invocation.<Integer>getArgument(1));
+            return null;
+        }).when(apiService).deleteByApiPathHttpMethodRpcType(anyString(), anyInt(), anyString());
+        when(apiService.createOrUpdate(any(ApiDTO.class))).thenAnswer(invocation -> {
+            ApiDTO api = invocation.getArgument(0);
+            DocItem document = GsonUtils.getInstance().fromJson(api.getDocument(), DocItem.class);
+            registeredSummaries.put(api.getHttpMethod(), document.getSummary());
+            return "saved";
+        });
+
+        importer.addDocInfo(instance, body, null, info -> { });
+        importer.addDocInfo(instance, body, null, info -> { });
+
+        assertAll(
+                () -> assertEquals(3, registeredSummaries.size()),
+                () -> assertEquals("List orders", registeredSummaries.get(get)),
+                () -> assertEquals("Place order", registeredSummaries.get(post)),
+                () -> assertEquals("Manually managed operation", registeredSummaries.get(put)));
+    }
